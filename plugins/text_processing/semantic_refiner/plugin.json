{
  "id": "text_processing.semantic_refiner",
  "name": "Semantic Refiner",
  "product_name": "Semantic Refiner",
  "highlights": "Очистка транскрипции, смысловые блоки и ключевые слова без внешних сервисов.",
  "description": "Плагин выполняет интеллектуальную чистку текста, разбивает его на логические блоки и извлекает наиболее значимые ключевые слова (сущности и термины).",
  "ui_stage": "text_processing",
  "capabilities": {
    "models": {
      "storage": "local",
      "selection_requires_installed": false,
      "managed_actions": {
        "list": "list_models",
        "pull": "download_model",
        "remove": "remove_model"
      }
    },
    "ui": {
      "text_processing": {
        "group": "essentials"
      }
    }
  },
  "tags": ["Cleaning", "NLP", "Keywords"],
  "version": "1.0.0",
  "api_version": "1",
  "entrypoint": "plugins.text_processing.semantic_refiner.semantic_refiner:Plugin",
  "hooks": [
    { "name": "postprocess.after_transcribe", "mode": "optional", "priority": 50 }
  ],
  "artifacts": ["edited", "semantic_blocks", "important_keywords"],
  "ui_schema": {
    "settings": [
      {
        "key": "embeddings_enabled",
        "label": "Use embeddings",
        "type": "bool",
        "value": true
      },
      {
        "key": "embeddings_model_id",
        "label": "Embeddings model",
        "type": "string",
        "value": "intfloat/multilingual-e5-base",
        "editable": true
      },
      {
        "key": "embeddings_allow_download",
        "label": "Allow automatic download",
        "type": "bool",
        "value": true
      }
    ]
  }
}

